<% layout("layouts/boilerplate") %>

<div class="row justify-content-center">

    <div class="col-md-8">

        <div class="card shadow border-0">

            <img
                src="<%= restaurant.image %>"
                class="card-img-top show-img"
                alt="<%= restaurant.title %>"
            >


            <div class="card-body p-4">

                <div class="d-flex justify-content-between">

                    <h1>
                        <%= restaurant.title %>
                    </h1>

                    <span class="rating">
                        ⭐ <%= restaurant.rating %>
                    </span>

                </div>


                <p class="lead">
                    <%= restaurant.description %>
                </p>


                <hr>


                <p>
                    🍽️ <b>Cuisine:</b>
                    <%= restaurant.cuisine %>
                </p>


                <p>
                    💰 <b>Price:</b>
                    ₹<%= restaurant.price %> for two
                </p>


                <p>
                    📍 <b>Location:</b>
                    <%= restaurant.location %>
                </p>


                <div class="mt-4">

                    <a
                        href="/restaurants"
                        class="btn btn-secondary"
                    >
                        ← Back
                    </a>


                    <a
                        href="/restaurants/<%= restaurant._id %>/edit"
                        class="btn btn-warning"
                    >
                        ✏️ Edit
                    </a>


                    <form
                        action="/restaurants/<%= restaurant._id %>?_method=DELETE"
                        method="POST"
                        class="d-inline"
                    >

                        <button
                            class="btn btn-danger"
                            onclick="return confirm('Are you sure you want to delete this restaurant?')"
                        >
                            🗑️ Delete
                        </button>

                    </form> 


                </div>

            </div>

        </div>


        <!-- ================= REVIEW FORM ================= -->

        <div class="card shadow-sm mt-4 p-4">

            <h3>⭐ Add a Review</h3>

            <form
                action="/restaurants/<%= restaurant._id %>/reviews"
                method="POST"
            >

                <!-- Rating -->

                <div class="mb-3">

                    <label class="form-label">
                        Rating
                    </label>

                    <select
                        name="review[rating]"
                        class="form-select"
                        required
                    >

                        <option value="">
                            Select Rating
                        </option>

                        <option value="1">⭐ 1</option>

                        <option value="2">⭐⭐ 2</option>

                        <option value="3">⭐⭐⭐ 3</option>

                        <option value="4">⭐⭐⭐⭐ 4</option>

                        <option value="5">⭐⭐⭐⭐⭐ 5</option>

                    </select>

                </div>


                <!-- Comment -->

                <div class="mb-3">

                    <label class="form-label">
                        Your Review
                    </label>

                    <textarea
                        name="review[comment]"
                        class="form-control"
                        rows="4"
                        placeholder="Write your experience..."
                        required
                    ></textarea>

                </div>


                <button class="btn btn-danger">

                    Submit Review

                </button>

            </form>

        </div>


        <!-- ================= ALL REVIEWS ================= -->

        <div class="mt-4">

            <h3>Customer Reviews</h3>


            <% if (restaurant.reviews.length === 0) { %>

                <p class="text-muted">
                    No reviews yet. Be the first to review!
                </p>

            <% } else { %>


                

                <% for (let review of restaurant.reviews) { %>

    <div class="card mb-3 shadow-sm">

        <div class="card-body">

            <h5>
                ⭐ <%= review.rating %> / 5
            </h5>

            <p>
                <%= review.comment %>
            </p>

            <form
                action="/restaurants/<%= restaurant._id %>/reviews/<%= review._id %>?_method=DELETE"
                method="POST"
            >

                <button class="btn btn-sm btn-danger">
                    🗑️ Delete Review
                </button>

            </form>

        </div>

    </div>

            <% } %>


            <% } %>

        </div>


    </div>

</div>