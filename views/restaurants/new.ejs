<% layout("layouts/boilerplate") %>

<div class="row justify-content-center">

    <div class="col-md-8 col-lg-6">

        <h2 class="mb-4">Add New Restaurant</h2>


        <form action="/restaurants" method="POST">

            <div class="mb-3">

                <label class="form-label">
                    Restaurant Name
                </label>

                <input
                    type="text"
                    name="restaurant[title]"
                    class="form-control"
                    required
                >

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Image URL
                </label>

                <input
                    type="url"
                    name="restaurant[image]"
                    class="form-control"
                >

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Description
                </label>

                <textarea
                    name="restaurant[description]"
                    class="form-control"
                    rows="3"
                ></textarea>

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Cuisine
                </label>

                <input
                    type="text"
                    name="restaurant[cuisine]"
                    class="form-control"
                >

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Price for Two
                </label>

                <input
                    type="number"
                    name="restaurant[price]"
                    class="form-control"
                >

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Rating
                </label>

                <input
                    type="number"
                    step="0.1"
                    min="0"
                    max="5"
                    name="restaurant[rating]"
                    class="form-control"
                >

            </div>


            <div class="mb-3">

                <label class="form-label">
                    Location
                </label>

                <input
                    type="text"
                    name="restaurant[location]"
                    class="form-control"
                >

            </div>


            <button class="btn btn-danger">
                Add Restaurant
            </button>


            <a
                href="/restaurants"
                class="btn btn-secondary"
            >
                Cancel
            </a>

        </form>

    </div>

</div>